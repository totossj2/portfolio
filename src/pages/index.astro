---
import Layout from "../layouts/Layout.astro";
import LinkedInIcon from "../icons/LinkedIn.astro";
import GitHubIcon from "../icons/GitHub.astro";
import MailIcon from "../icons/Mail.astro";
import SocialPill from "../components/SocialPill.astro";
import SectionContainer from "../components/SectionContainer.astro";
import CodeIcon from "../icons/Code.astro";
import Projects from "../components/Projects.astro";
import Badge from "../components/Badge.astro";
import WorkXp from "../components/WorkXp.astro";
import WorkIcon from "../icons/Work.astro";
import Work from "../icons/Work.astro";

---

<Layout
  title="Portfolio de Lorenzo - Desarrollador y Programador Web"
  description="Contrata a Lorenzo Ferrario como tu próximo desarrollador web. Conoce más sobre sus habilidades y proyectos en su portfolio."
>
  <main class="px-4">
    <SectionContainer id="sobre-mi" class="py-44 pb-32">
      <div class="flex gap-4 mb-4">
        <img
          class="rounded-full shadow-lg size-20"
          src="/totofacha.jpg"
          alt="Lorenzo Ferrario"
        />
		<a
		href="https://linkedin.com/in/ferrario-lorenzo"
		target="_blank"
		rel="noopener"
		class="flex items-center transition md:justify-center md:hover:scale-105"
	  >
		<Badge>Disponible para trabajar</Badge>
	  </a>
      </div>
      <h1
        class="text-white text-2xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-4 pb-6 lg:pb-10"
      >
        Lorenzo Ferrario - Analista de Datos
      </h1>
      <h2
        class="text-xl lg:text-2xl opacity-80 text-wrap text-pretty max-w-[700p]"
      >
      <p class="mb-4">
      Soy un desarrollador web en formación y estudiante de Ingeniería en Informática, apasionado por la creación de soluciones innovadoras en el ámbito de la tecnología. Durante mi carrera, he desarrollado aplicaciones móviles y sitios web funcionales, como un e-commerce propio utilizando Astro e integraciones con Mercado Pago.
      </p>
      <p class="mb-4">
      Actualmente, trabajo en una agencia de e-commerce, donde perfecciono mis habilidades técnicas y mi capacidad para resolver problemas en equipo.
      </p>
      <p class="mb-4">
      Además, estoy desarrollando mi propio emprendimiento de ropa para fanáticos de la Fórmula 1, combinando mi interés por los autos con mi conocimiento en programación y diseño. Mi pasión por el entrenamiento físico, especialmente el Jiu-Jitsu y el gimnasio, me ha enseñado disciplina, perseverancia y el valor del esfuerzo constante, cualidades que aplico en mi vida personal y profesional.
      </p>
      <p class="mb-4">
      Mi objetivo a largo plazo es liderar proyectos tecnológicos que marquen una diferencia real y alcanzar el éxito laboral mientras disfruto del proceso de aprendizaje y crecimiento continuo.
      </p>
      </h2>

      <nav class="flex gap-2 mt-8 flex-wrap">
        <SocialPill href="https://www.linkedin.com/in/ferrario-lorenzo/">
          <LinkedInIcon class="size-4 md:w-6 h-6" />
          LinkedIn
        </SocialPill>
        <SocialPill href="https://github.com/totossj2">
          <GitHubIcon class="size-4 md:w-6 h-6" />
          GitHub
        </SocialPill>
        <SocialPill href="mailto:ferrariolorenzo3@gmail.com">
          <MailIcon class="size-4 md:w-6 h-6" />
          ferrariolorenzo3@gmail.com
        </SocialPill>
      </nav>
    </SectionContainer>

    <SectionContainer id="work">
      <h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
        <Work class="size-7" />
        Experiencia Laboral
      </h2>
      <WorkXp />

    </SectionContainer>

    <SectionContainer id="proyectos">
      <h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
        <CodeIcon class="size-7" />
        Proyectos
      </h2>
      <Projects />
    </SectionContainer>
  </main>
</Layout>
